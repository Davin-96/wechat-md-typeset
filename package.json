{
  "name": "wechat-md-editor",
  "version": "2.5.0",
  "description": "选题管理 + Markdown 转微信公众号排版 · 50 套主题 · 苹果风界面 · 左右同频滚动 · 可自定义标题",
  "main": "src/main/main.js",
  "author": "阿文",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:nsis": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.qoder.wechatmd",
    "productName": "公众号排版工具",
    "directories": {
      "output": "out"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "公众号排版工具",
      "installerLanguages": ["zh_CN"],
      "language": "2052",
      "artifactName": "公众号排版工具-安装版-v${version}.exe"
    },
    "portable": {
      "artifactName": "公众号排版工具-便携版-v${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
